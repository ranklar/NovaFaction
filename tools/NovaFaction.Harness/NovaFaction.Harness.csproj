<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless match runner for tuning and determinism checks. Not shipped; it may use anything in .NET. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>NovaFaction.Harness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sim\NovaFaction.Sim\NovaFaction.Sim.csproj" />
  </ItemGroup>

</Project>
